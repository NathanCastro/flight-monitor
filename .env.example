# ============================================================
# Flight Monitor — Configurações
# ============================================================

# --- SMTP (Gmail recomendado) ---
# Para Gmail: crie uma "Senha de app" em:
#   myaccount.google.com → Segurança → Senhas de app
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# --- Destino dos alertas ---
ALERT_EMAIL=seu@gmail.com

# --- Configurações opcionais ---
LOG_LEVEL=INFO
HEADLESS=true
